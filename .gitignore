# GitHub에는 강의에 직접 사용하는 폴더만 포함한다.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/course/
!/parts/
!/hardware/
!/python/
!/v0/
!/v1/
!/v2/
!/v3/
!/v4/

# 공개 폴더 안에 들어가도 제외하는 자료
**/node_modules/
**/__pycache__/
**/.venv/
**/.pio/
**/.vscode/
**/build/
**/dist/
**/tmp/
*.pyc
*.bin
*.elf
*.log
*.csv
*.ppt
*.pptx
*.potx
*.hwp
*.hwpx
*.docx
*.pdf
*.zip
*.bundle
*.ndjson
*.layout.json
*.validation.json
~$*
.env
.env.*
!.env.example
secrets.h
credentials.json
*.pem
*.key
